{
  "name": "@mp-consulting/homebridge-config-glass-ui",
  "displayName": "Homebridge Glass UI",
  "type": "module",
  "version": "2.0.0-beta.4",
  "description": "A web based management, configuration and control platform for Homebridge, with a liquid glass interface.",
  "author": "Mickael Palma",
  "license": "MIT",
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "homepage": "https://github.com/mp-consulting/homebridge-config-glass-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-config-glass-ui.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-config-glass-ui/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homebridge-ui",
    "ui",
    "gui",
    "web",
    "config editor",
    "accessory control",
    "glass",
    "hb-service"
  ],
  "main": "./dist/index.js",
  "bin": {
    "hb-service": "dist/bin/hb-service.js",
    "homebridge-config-glass-ui": "dist/bin/glass-ui.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "prepare": "node scripts/apply-patches.mjs",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "rimraf dist && tsc -p tsconfig.build.json",
    "build:ui": "npm run build --prefix ui",
    "postbuild:ui": "node scripts/verify-monaco-assets.mjs && node scripts/check-bundle-size.mjs && node scripts/precompress.mjs",
    "check": "npm run check:server && npm run check:ui",
    "check:server": "npm install && npm outdated",
    "check:ui": "npm install --prefix ui && npm outdated --prefix ui",
    "lang-sync": "tsx scripts/lang-sync.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run lint && npm run build",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test-coverage": "npm run test -- --coverage",
    "test:ui": "npm run test --prefix ui",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "watch": "concurrently \"npm run watch:ui\" \"npm run watch:server\"",
    "watch:server": "nodemon",
    "watch:ui": "npm run start --prefix ui"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "@homebridge/hap-client": "5.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1",
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/websockets": "12.1.2",
    "@peculiar/x509": "2.1.0",
    "axios": "1.20.0",
    "bonjour-service": "1.4.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "commander": "15.0.0",
    "dayjs": "1.11.23",
    "fastify": "5.12.5",
    "fs-extra": "11.4.0",
    "node-cache": "5.1.2",
    "node-schedule": "2.1.1",
    "ora": "9.4.1",
    "otplib": "13.5.0",
    "p-limit": "7.3.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "systeminformation": "5.33.6",
    "tail": "2.2.6",
    "tar": "7.5.22",
    "unzipper": "0.12.5"
  },
  "optionalDependencies": {
    "macos-temperature-sensor": "2.0.0",
    "osx-temperature-sensor": "1.0.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@eslint-react/eslint-plugin": "^5.23.3",
    "@nestjs/testing": "^12.1.2",
    "@playwright/test": "1.63.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.0",
    "@types/node-schedule": "^2.1.8",
    "@types/passport-jwt": "^4.0.1",
    "@types/semver": "^7.8.0",
    "@types/tail": "^2.2.3",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "form-data": "^4.0.6",
    "jsonwebtoken": "9.0.3",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@homebridge/node-pty-prebuilt-multiarch": true,
    "@nestjs/core": false,
    "@scarf/scarf": false,
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true,
    "macos-temperature-sensor": true,
    "osx-temperature-sensor": true
  }
}
